DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Set DJANGO_SECRET_KEY before disabling debug mode.
PGHOST=shared-postgres
PGPORT=5432
PGDATABASE=anomaly_detection
PGUSER=anomaly_app
# Password of this project's PostgreSQL role.
PGPASSWORD=replace-with-project-password
PGSSLMODE=prefer
POSTGRES_NETWORK=shared-postgres-network
